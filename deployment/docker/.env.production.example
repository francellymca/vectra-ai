# ==========================================
# Vectra AI - Production Environment
# ==========================================

# n8n public configuration
N8N_HOST=your-domain.example.com
N8N_PORT=5678
N8N_PROTOCOL=https
WEBHOOK_URL=https://your-domain.example.com/
N8N_EDITOR_BASE_URL=https://your-domain.example.com/

# Timezone
GENERIC_TIMEZONE=America/Sao_Paulo
TZ=America/Sao_Paulo

# n8n security
N8N_ENCRYPTION_KEY=replace-with-a-secure-random-key
N8N_SECURE_COOKIE=true

# Authentication
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=replace-with-admin-user
N8N_BASIC_AUTH_PASSWORD=replace-with-a-strong-password